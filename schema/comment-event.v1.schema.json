                  "pattern": "^[a-z0-9-]+$"
                }
              },
              "required": [
                "kind",
                "name"
              ],
              "additionalProperties": false
            }
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "canvasHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-fA-F]+$"
        },
        "target": {
          "type": "object",
          "properties": {
            "frame": {
              "type": "string"
            },
            "element": {
              "type": "object",
              "properties": {
                "doanId": {
                  "type": "string"
                },
                "selector": {
                  "type": "string"
                },
                "html": {
                  "type": "string",
                  "maxLength": 2000
                },
                "text": {
                  "type": "string"
                },
                "truncated": {
                  "type": "boolean"
                }
              },
              "required": [
                "selector",
                "html"
              ],
              "additionalProperties": false
            }
          },
          "required": [],
