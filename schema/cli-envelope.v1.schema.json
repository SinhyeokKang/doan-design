{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://doan.design/schema/cli-envelope.v1.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "ok": {
          "const": true
        },
        "result": {}
      },
      "required": [
        "v",
        "ok",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z]+(_[a-z]+)*$"
            },
            "message": {
              "type": "string"
            },
            "nextSteps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "config": {
              "$comment": "Absolute path of the config file that caused the failure; absent when the failure is not about a config file.",
              "type": "string",
              "pattern": "^/"
            },
            "storageReason": {
              "$comment": "Only on ls's repo_not_found for an existing directory that belongs to no Git repository (a .git at or above HOME does not count): Keep out of Git there needs a new repository, created only with --git-init. Absent on every other failure.",
              "const": "not_git"
            }
          },
          "required": [
            "code",
            "message",
            "nextSteps"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "v",
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
