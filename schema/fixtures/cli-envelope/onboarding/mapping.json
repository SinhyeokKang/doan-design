          "revision": 0,
          "completed": false,
          "agents": {
            "revision": 1,
            "providers": []
          },
          "project": null,
          "operations": []
        }
      },
      "expect": {
        "ok": true,
        "exit": 0
      }
    },
    {
      "name": "status reports failed and cancelled operations as data",
      "op": "status",
      "reply": {
        "v": 2,
        "ok": true,
        "op": "status",
        "result": {
          "sessionId": "s_7Hq2",
          "revision": 4,
          "completed": false,
          "agents": {
            "revision": 12,
            "providers": [
              {
                "provider": "claude",
                "phase": "connected",
                "readiness": {
                  "ready": true
                },
                "error": null,
                "actions": [
                  "signOut"
                ]
              },
              {
                "provider": "cursor",
                "phase": "disconnected",
                "readiness": {
                  "ready": false,
