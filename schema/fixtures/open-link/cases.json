{
  "description": "Cases for the Go link builder (canvasLink) and the TS reader (parseOpenLink). Encoding rule: build each value from its UTF-8 bytes, percent-encoding every byte except the RFC 3986 unreserved characters A-Z a-z 0-9 - . _ ~ with uppercase hex; space is %20, never '+', and '/' is %2F. Go's url.QueryEscape with '+' replaced by %20 produces exactly this, and URLSearchParams decodes it back to the original. Parameters appear in the order root, canvas, frame. Build cases: input root, path, optional frame, and the expected URL. Refuse cases: a URL the reader must reject. Over-length cases use 10000-character values, so the implementation's length limit must be below that.",
  "build": [
    {
      "name": "plain",
      "root": "/Users/me/repo",
      "path": ".doan/canvases/home.html",
      "expected": "doan://open?root=%2FUsers%2Fme%2Frepo&canvas=.doan%2Fcanvases%2Fhome.html"
    },
    {
      "name": "ds-canvas",
      "root": "/Users/me/repo",
      "path": ".doan/ds/tokens.html",
      "expected": "doan://open?root=%2FUsers%2Fme%2Frepo&canvas=.doan%2Fds%2Ftokens.html"
    },
    {
      "name": "with-frame",
      "root": "/Users/me/repo",
      "path": ".doan/canvases/home.html",
      "frame": "frame-1",
      "expected": "doan://open?root=%2FUsers%2Fme%2Frepo&canvas=.doan%2Fcanvases%2Fhome.html&frame=frame-1"
    },
    {
      "name": "space-in-root",
      "root": "/Users/me/my repo",
      "path": ".doan/canvases/home.html",
      "expected": "doan://open?root=%2FUsers%2Fme%2Fmy%20repo&canvas=.doan%2Fcanvases%2Fhome.html"
    },
    {
      "name": "space-in-path",
      "root": "/Users/me/repo",
      "path": ".doan/canvases/my page.html",
      "expected": "doan://open?root=%2FUsers%2Fme%2Frepo&canvas=.doan%2Fcanvases%2Fmy%20page.html"
    },
    {
      "name": "korean-root",
      "root": "/Users/me/저장소",
      "path": ".doan/canvases/home.html",
      "expected": "doan://open?root=%2FUsers%2Fme%2F%EC%A0%80%EC%9E%A5%EC%86%8C&canvas=.doan%2Fcanvases%2Fhome.html"
    },
    {
      "name": "korean-path",
      "root": "/Users/me/repo",
      "path": ".doan/canvases/홈 화면.html",
      "expected": "doan://open?root=%2FUsers%2Fme%2Frepo&canvas=.doan%2Fcanvases%2F%ED%99%88%20%ED%99%94%EB%A9%B4.html"
    },
    {
      "name": "percent-in-path",
      "root": "/Users/me/repo",
      "path": ".doan/canvases/100%.html",
      "expected": "doan://open?root=%2FUsers%2Fme%2Frepo&canvas=.doan%2Fcanvases%2F100%25.html"
    },
    {
      "name": "ampersand-in-path",
      "root": "/Users/me/repo",
      "path": ".doan/canvases/a&b.html",
      "expected": "doan://open?root=%2FUsers%2Fme%2Frepo&canvas=.doan%2Fcanvases%2Fa%26b.html"
    },
    {
      "name": "plus-and-equals",
      "root": "/Users/me/c++ = repo",
      "path": ".doan/canvases/a+b=c.html",
      "expected": "doan://open?root=%2FUsers%2Fme%2Fc%2B%2B%20%3D%20repo&canvas=.doan%2Fcanvases%2Fa%2Bb%3Dc.html"
    },
    {
      "name": "hash-and-question",
      "root": "/Users/me/repo#1?x",
      "path": ".doan/canvases/a#b?.html",
      "expected": "doan://open?root=%2FUsers%2Fme%2Frepo%231%3Fx&canvas=.doan%2Fcanvases%2Fa%23b%3F.html"
    },
    {
      "name": "percent-looking-sequence",
      "root": "/Users/me/%41",
      "path": ".doan/canvases/%20.html",
      "expected": "doan://open?root=%2FUsers%2Fme%2F%2541&canvas=.doan%2Fcanvases%2F%2520.html"
    },
    {
      "name": "frame-with-reserved",
      "root": "/Users/me/repo",
      "path": ".doan/canvases/home.html",
      "frame": "frame a&b=1/2%",
      "expected": "doan://open?root=%2FUsers%2Fme%2Frepo&canvas=.doan%2Fcanvases%2Fhome.html&frame=frame%20a%26b%3D1%2F2%25"
    },
    {
      "name": "frame-korean",
      "root": "/Users/me/repo",
      "path": ".doan/canvases/home.html",
      "frame": "프레임 1",
      "expected": "doan://open?root=%2FUsers%2Fme%2Frepo&canvas=.doan%2Fcanvases%2Fhome.html&frame=%ED%94%84%EB%A0%88%EC%9E%84%201"
    },
    {
      "name": "tilde-dot-dash-stay-literal",
      "root": "/Users/me/~a.b-c_d",
      "path": ".doan/canvases/home.html",
      "frame": "x~y",
      "expected": "doan://open?root=%2FUsers%2Fme%2F~a.b-c_d&canvas=.doan%2Fcanvases%2Fhome.html&frame=x~y"
    }
  ],
