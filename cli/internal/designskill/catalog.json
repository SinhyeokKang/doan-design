      ]
    },
    {
      "id": "extract",
      "title": "Extract reusable patterns",
      "description": "Find tokens, components, and patterns the design repeats and propose how to consolidate them; refactor app code only on request.",
      "scope": "tokens and patterns",
      "sources": [
        {"repository": "https://github.com/pbakaus/impeccable", "commit": "d34c87e1a00989ae8dbdd7f6b30b70f23319e860", "path": "skill/reference/extract.md"}
      ]
    },
    {
