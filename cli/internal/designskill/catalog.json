      ]
    },
    {
      "id": "polish",
      "title": "Polish the details",
      "description": "Finish a design for consistency and completeness while keeping its identity, content, and function.",
      "scope": "visual finish",
      "sources": [
        {"repository": "https://github.com/pbakaus/impeccable", "commit": "d34c87e1a00989ae8dbdd7f6b30b70f23319e860", "path": "skill/reference/polish.md"},
