    {
      "id": "distill",
      "title": "Simplify the design",
      "description": "Remove redundant elements, noise, and complexity without dropping function or product facts the user has not agreed to cut.",
      "scope": "content and structure",
      "sources": [
        {"repository": "https://github.com/pbakaus/impeccable", "commit": "d34c87e1a00989ae8dbdd7f6b30b70f23319e860", "path": "skill/reference/distill.md"}
      ]
    },
    {
      "id": "bolder",
      "title": "Make it bolder",
      "description": "Strengthen the visual emphasis of the requested target using the design system's own vocabulary.",
      "scope": "visual emphasis",
      "sources": [
        {"repository": "https://github.com/pbakaus/impeccable", "commit": "d34c87e1a00989ae8dbdd7f6b30b70f23319e860", "path": "skill/reference/bolder.md"}
