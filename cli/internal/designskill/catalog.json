      "id": "layout",
      "title": "Improve the layout",
      "description": "Improve arrangement, spacing, grouping, and reading order so product priority reads clearly at every covered width.",
      "scope": "layout and spacing",
      "sources": [
        {"repository": "https://github.com/pbakaus/impeccable", "commit": "d34c87e1a00989ae8dbdd7f6b30b70f23319e860", "path": "skill/reference/layout.md"},
