      "id": "colorize",
      "title": "Improve the color",
      "description": "Improve color roles and contrast with token CSS variables while keeping brand colors and meaning intact.",
      "scope": "color and contrast",
      "sources": [
        {"repository": "https://github.com/pbakaus/impeccable", "commit": "d34c87e1a00989ae8dbdd7f6b30b70f23319e860", "path": "skill/reference/colorize.md"}
      ]
