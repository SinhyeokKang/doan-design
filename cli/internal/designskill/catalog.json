      ]
    },
    {
      "id": "onboard",
      "title": "Design first use",
      "description": "Design first-run flows, empty states, and next actions that get new users to a real result without invented claims.",
      "scope": "first use",
      "sources": [
        {"repository": "https://github.com/pbakaus/impeccable", "commit": "d34c87e1a00989ae8dbdd7f6b30b70f23319e860", "path": "skill/reference/onboard.md"},
